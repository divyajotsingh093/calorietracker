# Server-side OpenRouter key, read only by api/openrouter.ts. Never prefixed
# VITE_ — that would inline it into the browser bundle.
# Set it in Vercel → Settings → Environment Variables, not in a committed file.
OPENROUTER_API_KEY=

# Optional. When set, the proxy requires this code in an x-nova-access header,
# and the app asks for it once per browser. Without it, anyone who can reach the
# deployment can spend the key's credits.
NOVA_ACCESS_CODE=
